  1 | # ============================================================
  2 | # Régimes de marché du S&P 500 (k-means / GMM) vs récessions USREC
  3 | # Script unique regroupant les étapes 1 à 8 (à exécuter dans Google Colab)
  4 | # ============================================================
  5 | 
  6 | import pandas as pd
  7 | import numpy as np
  8 | import matplotlib.pyplot as plt
  9 | from sklearn.cluster import KMeans
 10 | from sklearn.mixture import GaussianMixture
 11 | from sklearn.metrics import silhouette_score, adjusted_rand_score
 12 | from google.colab import files
 13 | from IPython.display import display
 14 | 
 15 | 
 16 | # ============================================================
 17 | # Étape 1 : Télécharger les données
 18 | # ============================================================
 19 | 
 20 | # Sélectionne SP500.csv ET USREC.csv
 21 | uploaded = files.upload()
 22 | f_sp  = [f for f in uploaded if "SP500" in f.upper()][0]
 23 | f_rec = [f for f in uploaded if "USREC" in f.upper()][0]
 24 | 
 25 | # S&P 500 : un prix par jour (les "." des jours fériés deviennent des cases vides, puis supprimées)
 26 | sp = pd.read_csv(f_sp)
 27 | sp.columns = ["date", "prix"]
 28 | sp["date"] = pd.to_datetime(sp["date"])
 29 | sp["prix"] = pd.to_numeric(sp["prix"], errors="coerce")
 30 | sp = sp.dropna().set_index("date").sort_index()
 31 | prix = sp["prix"]
 32 | 
 33 | # USREC : un chiffre par mois (1 = récession)
 34 | rec = pd.read_csv(f_rec)
 35 | rec.columns = ["date", "usrec"]
 36 | rec["date"] = pd.to_datetime(rec["date"])
 37 | rec = rec.set_index("date").sort_index()
 38 | 
 39 | print("S&P 500 :", len(prix), "jours,", prix.index.min().date(), "→", prix.index.max().date())
 40 | print("Mois en récession dans la période :")
 41 | print(rec.loc[prix.index.min():prix.index.max()].query("usrec == 1").index.strftime("%Y-%m").tolist())
 42 | 
 43 | plt.figure(figsize=(12, 3))
 44 | prix.plot(color="grey", title="S&P 500 (vérification)")
 45 | plt.show()
 46 | 
 47 | 
 48 | # ============================================================
 49 | # Étape 2 : Volatilité et rendement sur 20 jours
 50 | # ============================================================
 51 | 
 52 | FENETRE_FEATURES = 20
 53 | 
 54 | rendement_jour = prix.pct_change()   # (prix aujourd'hui - hier) / hier
 55 | 
 56 | features = pd.DataFrame({
 57 |     "volatilite": rendement_jour.rolling(FENETRE_FEATURES).std(),   # agitation du dernier mois
 58 |     "rendement":  rendement_jour.rolling(FENETRE_FEATURES).mean(),  # tendance du dernier mois
 59 | }).dropna()   # les 20 premiers jours n'ont pas assez d'historique
 60 | 
 61 | print("Lignes après étape 2 :", len(features))
 62 | display(features.describe())
 63 | 
 64 | 
 65 | # ============================================================
 66 | # Étape 3 : Standardiser avec les 252 jours précédents
 67 | # ============================================================
 68 | 
 69 | FENETRE_NORMALE = 252
 70 | 
 71 | # La "normale" du jour J = les 252 jours AVANT J.
 72 | # shift(1) : J n'est jamais comparé à lui-même ni au futur (pas de fuite d'information).
 73 | moy_passee = features.rolling(FENETRE_NORMALE).mean().shift(1)
 74 | std_passee = features.rolling(FENETRE_NORMALE).std().shift(1)
 75 | 
 76 | Z = ((features - moy_passee) / std_passee).dropna()   # valeurs standardisées
 77 | X = Z.values
 78 | features_ok = features.loc[Z.index]                   # valeurs d'origine alignées (plus lisibles)
 79 | 
 80 | print("Lignes après étape 3 :", len(Z))
 81 | print(Z.describe().loc[["mean", "std", "min", "max"]].round(2))
 82 | 
 83 | 
 84 | # ============================================================
 85 | # Étape 4 : K-means avec 2, 3, 4, 5 groupes + silhouette
 86 | # ============================================================
 87 | 
 88 | resultats_sil = {}
 89 | for k in [2, 3, 4, 5]:
 90 |     km = KMeans(n_clusters=k, n_init=10, random_state=42).fit(X)
 91 |     resultats_sil[k] = silhouette_score(X, km.labels_)
 92 | 
 93 | print("Scores de silhouette (k-means) :")
 94 | for k, s in resultats_sil.items():
 95 |     print(f"  k = {k} : {s:.3f}")
 96 | 
 97 | k_silhouette = max(resultats_sil, key=resultats_sil.get)
 98 | print(f"\n→ Meilleur k selon la silhouette : {k_silhouette}")
 99 | 
100 | plt.figure(figsize=(5, 3))
101 | plt.plot(list(resultats_sil.keys()), list(resultats_sil.values()), marker="o")
102 | plt.xlabel("Nombre de groupes k")
103 | plt.ylabel("Silhouette")
104 | plt.title("Choix de k")
105 | plt.xticks([2, 3, 4, 5])
106 | plt.grid(alpha=.3)
107 | plt.show()
108 | 
109 | # ===== TON CHOIX =====
110 | # La fiche parle de 3 régimes. Garde 3 en justifiant dans le rapport,
111 | # ou remplace par : K = k_silhouette
112 | K = 3
113 | print(f"K retenu pour la suite : {K}")
114 | 
115 | 
116 | # ============================================================
117 | # Étape 5 : Nommer les régimes
118 | # ============================================================
119 | 
120 | NOMS = {
121 |     2: ["Calme", "Tempête"],
122 |     3: ["Calme", "Intermédiaire", "Tempête"],
123 |     4: ["Calme", "Intermédiaire bas", "Intermédiaire haut", "Tempête"],
124 |     5: ["Calme", "Modéré", "Intermédiaire", "Agité", "Tempête"],
125 | }
126 | COULEURS = {"Calme": "green", "Modéré": "yellowgreen", "Intermédiaire bas": "gold",
127 |             "Intermédiaire": "orange", "Intermédiaire haut": "darkorange",
128 |             "Agité": "orangered", "Tempête": "red"}
129 | ORDRE = NOMS[K]
130 | 
131 | def nommer(labels):
132 |     """Classe les groupes du moins au plus volatil (valeurs d'origine) et leur donne un nom."""
133 |     vol_moy = features_ok["volatilite"].groupby(labels).mean().sort_values()
134 |     mapping = {cluster: nom for cluster, nom in zip(vol_moy.index, ORDRE)}
135 |     return pd.Series(labels, index=features_ok.index).map(mapping)
136 | 
137 | # K-means final
138 | kmeans = KMeans(n_clusters=K, n_init=10, random_state=42).fit(X)
139 | reg_km = nommer(kmeans.labels_)
140 | 
141 | tab5 = features_ok.assign(regime=reg_km).groupby("regime").agg(
142 |     volatilite=("volatilite", "mean"),
143 |     rendement=("rendement", "mean"),
144 |     jours=("volatilite", "size"),
145 | ).loc[ORDRE]
146 | 
147 | print("Régimes k-means :")
148 | display(tab5.style.format({"volatilite": "{:.4f}", "rendement": "{:.5f}"}))
149 | 
150 | 
151 | # ============================================================
152 | # Étape 6 : GMM et comparaison avec k-means (Tableau 1)
153 | # ============================================================
154 | 
155 | gmm = GaussianMixture(n_components=K, covariance_type="full", n_init=5, random_state=42).fit(X)
156 | labels_gmm = gmm.predict(X)
157 | reg_gmm = nommer(labels_gmm)
158 | certitude = gmm.predict_proba(X).max(axis=1).mean()
159 | 
160 | # --- Tableau 1 ---
161 | jours = pd.DataFrame({"K-means": reg_km.value_counts(), "GMM": reg_gmm.value_counts()}).loc[ORDRE]
162 | 
163 | tableau1 = pd.DataFrame({
164 |     "Silhouette": [silhouette_score(X, kmeans.labels_), silhouette_score(X, labels_gmm)],
165 | }, index=["K-means", "GMM"]).round(3)
166 | for nom in ORDRE:
167 |     tableau1[f"Jours {nom}"] = [jours.loc[nom, "K-means"], jours.loc[nom, "GMM"]]
168 | 
169 | print("===== TABLEAU 1 : k-means contre GMM =====")
170 | display(tableau1)
171 | 
172 | print(f"Accord k-means / GMM (adjusted Rand) : {adjusted_rand_score(reg_km, reg_gmm):.3f}")
173 | print(f"Certitude moyenne du GMM : {certitude:.1%}")
174 | 
175 | print("\nTableau croisé (lignes = k-means, colonnes = GMM) :")
176 | display(pd.crosstab(reg_km, reg_gmm).reindex(index=ORDRE, columns=ORDRE, fill_value=0))
177 | 
178 | 
179 | # ============================================================
180 | # Étape 7 : Comparer avec les récessions (Tableau 2)
181 | # ============================================================
182 | 
183 | # Chaque jour reçoit la valeur USREC de son mois
184 | rec_mensuel = rec["usrec"].copy()
185 | rec_mensuel.index = rec_mensuel.index.to_period("M")
186 | mois_jour = features_ok.index.to_period("M")
187 | recession_jour = pd.Series(rec_mensuel.reindex(mois_jour).values, index=features_ok.index)
188 | 
189 | df = pd.DataFrame({"regime": reg_km, "recession": recession_jour}).dropna()
190 | df["recession"] = df["recession"].astype(int)
191 | 
192 | # --- Tableau 2 : régimes × récessions ---
193 | t2_n = pd.crosstab(df["regime"], df["recession"]).reindex(index=ORDRE, columns=[0, 1], fill_value=0)
194 | t2_n.columns = ["Pas de récession (0)", "Récession (1)"]
195 | t2_pct = (t2_n / t2_n.sum() * 100).round(1)   # pourcentages par colonne
196 | 
197 | print("===== TABLEAU 2 : nombre de jours =====")
198 | display(t2_n)
199 | print("Pourcentages par colonne :")
200 | display(t2_pct)
201 | 
202 | # --- Jours Tempête par année ---
203 | tempete = df[df["regime"] == "Tempête"]
204 | tempete_par_an = tempete.groupby(tempete.index.year).size()
205 | print("Jours classés 'Tempête' par année :")
206 | display(tempete_par_an.to_frame("jours Tempête"))
